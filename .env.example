# -----------------------------------------------------------------------------
# .env.example — TEMPLATE ONLY.
#
# Copy this file to .env and fill in real values. NEVER commit your .env file.
# The Staff Engineer security model is env-only: no secrets in source control,
# no secrets in prompts, no long-lived tokens in agent context.
# See docs/SECURITY-MODEL.md for the threat model and non-negotiable rules.
# -----------------------------------------------------------------------------

# API key for Anthropic models used by the agent roles.
ANTHROPIC_API_KEY=

# API key for OpenAI models, if you run any agent against OpenAI.
OPENAI_API_KEY=

# Short-lived token used by the Live QA runner to execute the stopping
# condition in an isolated environment. Rotate per sprint.
LIVE_QA_RUNNER_TOKEN=
